{
  // Deploy no Cloudflare Workers via OpenNext (@opennextjs/cloudflare).
  // Build: `npm run deploy` (opennextjs-cloudflare build + wrangler deploy).
  // Sem bindings: o frontend fala com o backend via HTTPS (NEXT_PUBLIC_API_URL).
  "name": "enem-read",
  "compatibility_date": "2026-09-01",
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
